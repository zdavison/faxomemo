#!/bin/bash
# One-command bootstrap: venv setup, printer transport detection, server start.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_DIR"

ENV_FILE=".faxomemo.env"
VENV_DIR=".venv"
BT_SCAN_TIMEOUT=12
PORT="${FAXOMEMO_PORT:-3290}"
INSTALL_DIR="${FAXOMEMO_INSTALL_DIR:-$HOME/.local/share/faxomemo}"
UNIT_DIR="${FAXOMEMO_UNIT_DIR:-$HOME/.config/systemd/user}"
POLL_INTERVAL="${FAXOMEMO_POLL_INTERVAL:-30}"

REDISCOVER=0
DRY_RUN=0
DAEMON=0
INSTALL=0
UNINSTALL=0
SKIP_READY=0
WEB=0
TRANSPORT_OVERRIDE=""

usage() {
    cat <<'EOF'
Usage: ./faxomemo [--help] [--rediscover] [--transport usb|bluetooth] [--dry-run]
                  [--skip-ready] [--install-daemon] [--uninstall-daemon] [--daemon]
       ./faxomemo web

Sets up the environment and starts the PC-1 server with the Phomemo M220 driver.

  1. Creates .venv and installs dependencies if missing (idempotent).
  2. Detects the printer transport: USB if the device file exists, otherwise
     scans for the M220 over Bluetooth and pairs/trusts it.
  3. Persists the working config to .faxomemo.env and reuses it on later runs.
  4. Execs `uvicorn app.main:app --host 0.0.0.0 --port 3290` with
     PC1_PRINTER_DRIVER=phomemo and the detected transport env vars applied.

Commands:
  web                     Open the faxomemo UI in your browser. Starts the
                          installed service first if nothing is listening.
                          Override the port with FAXOMEMO_PORT.

Flags:
  --help                  Show this help and exit.
  --rediscover            Force a fresh Bluetooth scan, ignoring any saved config.
  --transport usb|bluetooth
                          Skip auto-detection and use the given transport.
  --dry-run               Print setup checks, detection result, and the final
                          env + command, without pairing, writing .faxomemo.env,
                          or starting the server.
  --skip-ready            Do not print the SYSTEM READY receipt on startup.
                          (First-boot WELCOME receipts still print.)
  --install-daemon        Install faxomemo as a background service: copies the
                          app to ~/.local/share/faxomemo (override with
                          FAXOMEMO_INSTALL_DIR), builds its venv there, and
                          enables a systemd user unit that runs it with
                          --daemon. Safe to re-run to update the install.
  --uninstall-daemon      Stop and remove the systemd user unit and delete the
                          installed copy.
  --daemon                Run non-interactively for the systemd unit: poll for
                          a printer every ${FAXOMEMO_POLL_INTERVAL:-30}s
                          instead of exiting when none is found, and pick the
                          first match when several Bluetooth devices qualify.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --help)
            usage
            exit 0
            ;;
        --rediscover)
            REDISCOVER=1
            ;;
        --transport)
            shift
            TRANSPORT_OVERRIDE="${1:-}"
            if [ "$TRANSPORT_OVERRIDE" != "usb" ] && [ "$TRANSPORT_OVERRIDE" != "bluetooth" ]; then
                echo "Error: --transport requires 'usb' or 'bluetooth'" >&2
                exit 1
            fi
            ;;
        --dry-run)
            DRY_RUN=1
            ;;
        --daemon)
            DAEMON=1
            ;;
        --skip-ready)
            SKIP_READY=1
            ;;
        --install-daemon)
            INSTALL=1
            ;;
        --uninstall-daemon)
            UNINSTALL=1
            ;;
        web)
            WEB=1
            ;;
        *)
            echo "Error: unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
    shift
done

log() {
    echo "[faxomemo] $*" >&2
}

# Some standalone Python distributions (e.g. uv's python-build-standalone) are
# compiled without Bluetooth support: socket.AF_BLUETOOTH is missing, which
# breaks the phomemo Bluetooth transport at runtime. System pythons normally
# have it. Exit 0 if $1 supports it, 1 otherwise (or if $1 isn't runnable).
python_has_bluetooth() {
    local py="$1"
    [ -x "$py" ] || command -v "$py" >/dev/null 2>&1 || return 1
    "$py" -c 'import socket, sys; sys.exit(0 if hasattr(socket, "AF_BLUETOOTH") else 1)' 2>/dev/null
}

pick_bluetooth_capable_python() {
    local candidate
    for candidate in /usr/bin/python3 python3; do
        if python_has_bluetooth "$candidate"; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

setup_venv() {
    local marker="$VENV_DIR/.faxomemo-deps-installed"

    if [ -x "$VENV_DIR/bin/python" ]; then
        if python_has_bluetooth "$VENV_DIR/bin/python"; then
            log "Virtualenv already present at $VENV_DIR."
        else
            local replacement
            if replacement="$(pick_bluetooth_capable_python)"; then
                log "Recreating .venv: current Python lacks Bluetooth support (falls back to USB-only)."
                if [ "$DRY_RUN" -eq 1 ]; then
                    log "(dry-run) would remove $VENV_DIR and recreate with $replacement."
                else
                    rm -rf "$VENV_DIR"
                    "$replacement" -m venv "$VENV_DIR"
                    rm -f "$marker"
                fi
            else
                log "Warning: no Python with Bluetooth support found; the Bluetooth transport will not work (USB is unaffected). Keeping existing venv."
            fi
        fi
    fi

    if [ ! -x "$VENV_DIR/bin/python" ]; then
        local py
        if ! py="$(pick_bluetooth_capable_python)"; then
            log "Warning: no Python with Bluetooth support found; the Bluetooth transport will not work (USB is unaffected)."
            py="python3"
        fi
        log "Creating virtualenv at $VENV_DIR (using $py)..."
        if [ "$DRY_RUN" -eq 1 ]; then
            log "(dry-run) would run: $py -m venv $VENV_DIR"
        else
            "$py" -m venv "$VENV_DIR"
        fi
    fi

    if [ ! -f "$marker" ]; then
        log "Installing dependencies from requirements.txt..."
        if [ "$DRY_RUN" -eq 1 ]; then
            log "(dry-run) would run: $VENV_DIR/bin/pip install -r requirements.txt"
        else
            "$VENV_DIR/bin/pip" install -q -r requirements.txt
            touch "$marker"
        fi
    else
        log "Dependencies already installed."
    fi
}

usb_device_path() {
    echo "${PC1_PHOMEMO_USB_DEVICE:-/dev/usb/lp0}"
}

detect_usb() {
    local dev
    dev="$(usb_device_path)"
    if [ -e "$dev" ]; then
        log "Found USB printer device at $dev."
        return 0
    fi
    log "No USB device found at $dev."
    return 1
}

# The M220 sometimes advertises its serial number (e.g. "Q198G5BR6410063")
# instead of a recognizable name, so name matching alone is unreliable.
# Fall back to bluez's device-class rendering: `bluetoothctl info <mac>`
# reports `Icon: printer` for the imaging/printer class, which is the
# reliable signal for this hardware.
bt_is_printer_by_class() {
    local mac="$1"
    local info
    info="$(bluetoothctl info "$mac" 2>/dev/null || true)"
    echo "$info" | grep -q 'Icon: printer'
}

bt_candidate_devices() {
    local all line mac name candidates=""
    all="$(bluetoothctl devices 2>/dev/null || true)"
    [ -z "$all" ] && return 0

    while IFS= read -r line; do
        [ -z "$line" ] && continue
        mac="$(echo "$line" | awk '{print $2}')"
        name="$(echo "$line" | cut -d' ' -f3-)"
        if echo "$name" | grep -qiE 'M220|Mr\.in|Phomemo'; then
            candidates="${candidates}${line}"$'\n'
        elif bt_is_printer_by_class "$mac"; then
            candidates="${candidates}${line}"$'\n'
        fi
    done <<< "$all"

    printf '%s' "$candidates" | sed '/^$/d' | awk '!seen[$2]++'
}

bt_scan_and_list() {
    if ! command -v bluetoothctl >/dev/null 2>&1; then
        log "bluetoothctl not found; cannot perform Bluetooth discovery."
        return 1
    fi
    log "Scanning for Bluetooth devices (${BT_SCAN_TIMEOUT}s)..."
    bluetoothctl --timeout "$BT_SCAN_TIMEOUT" scan on >/dev/null 2>&1 || true
    bt_candidate_devices
}

pair_and_trust() {
    local mac="$1"
    log "Pairing with $mac..."
    local pair_out
    pair_out="$(bluetoothctl pair "$mac" 2>&1 || true)"
    if echo "$pair_out" | grep -qiE 'Pairing successful|AlreadyExists|already paired'; then
        log "Pairing OK ($mac)."
    else
        log "Warning: pairing result unclear for $mac:"
        echo "$pair_out" | sed 's/^/[bluetoothctl] /'
    fi
    log "Trusting $mac..."
    bluetoothctl trust "$mac" >/dev/null 2>&1 || true
}

detect_bluetooth() {
    local matches
    matches="$(bt_scan_and_list)" || return 1

    if [ -z "$matches" ]; then
        log "No M220/Phomemo devices found via Bluetooth."
        log "Guidance: power on the printer, then hold the power button to enter pairing mode, and retry."
        log "Note: the printer may advertise its serial number instead of a model name; run 'bluetoothctl devices' to check for an unfamiliar device near you."
        return 1
    fi

    local count
    count="$(echo "$matches" | wc -l)"

    local mac name
    if [ "$count" -eq 1 ]; then
        mac="$(echo "$matches" | awk '{print $2}')"
        name="$(echo "$matches" | cut -d' ' -f3-)"
        log "Found Bluetooth device: $name ($mac)"
    elif [ "$DAEMON" -eq 1 ]; then
        mac="$(echo "$matches" | head -n1 | awk '{print $2}')"
        name="$(echo "$matches" | head -n1 | cut -d' ' -f3-)"
        log "Multiple matching Bluetooth devices; selecting the first: $name ($mac)"
    else
        echo "Multiple matching Bluetooth devices found:"
        echo "$matches" | nl -w2 -s') '
        local choice="" read_status=0 tty_openable=0
        if ( exec 3<>/dev/tty ) 2>/dev/null; then
            tty_openable=1
        fi
        if [ "$tty_openable" -eq 1 ]; then
            read -r -p "Select a device [1-$count]: " choice < /dev/tty || read_status=$?
        elif [ -t 0 ]; then
            read -r -p "Select a device [1-$count]: " choice || read_status=$?
        else
            echo "Error: multiple devices matched and no terminal is available to prompt for a selection." >&2
            return 1
        fi
        if [ "$read_status" -ne 0 ] || ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "$count" ]; then
            echo "Error: invalid selection." >&2
            return 1
        fi
        mac="$(echo "$matches" | sed -n "${choice}p" | awk '{print $2}')"
        name="$(echo "$matches" | sed -n "${choice}p" | cut -d' ' -f3-)"
        if [ -z "$mac" ]; then
            echo "Error: invalid selection." >&2
            return 1
        fi
        log "Selected: $name ($mac)"
    fi

    if ! [[ "$mac" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]]; then
        echo "Error: parsed value is not a valid MAC address: $mac" >&2
        return 1
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        log "(dry-run) would pair and trust $mac."
    else
        pair_and_trust "$mac"
    fi

    BT_ADDRESS="$mac"
    return 0
}

write_env_file() {
    if [ "$TRANSPORT" = "bluetooth" ] && ! [[ "$BT_ADDRESS" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]]; then
        echo "Error: refusing to write $ENV_FILE with an invalid Bluetooth address: '$BT_ADDRESS'" >&2
        exit 1
    fi
    log "Writing $ENV_FILE..."
    ( umask 177
      {
          echo "PC1_PRINTER_DRIVER=phomemo"
          echo "PC1_PHOMEMO_TRANSPORT=$TRANSPORT"
          if [ "$TRANSPORT" = "usb" ]; then
              echo "PC1_PHOMEMO_USB_DEVICE=$(usb_device_path)"
          else
              echo "PC1_PHOMEMO_BT_ADDRESS=$BT_ADDRESS"
          fi
      } > "$ENV_FILE" )
    chmod 600 "$ENV_FILE"
}

TRANSPORT=""
BT_ADDRESS="${PC1_PHOMEMO_BT_ADDRESS:-}"

# Sources $ENV_FILE and validates it, setting TRANSPORT and (for bluetooth)
# BT_ADDRESS on success. Must refresh BT_ADDRESS from the just-sourced
# PC1_PHOMEMO_BT_ADDRESS — it is NOT safe to rely on the top-level BT_ADDRESS
# default above, which was captured from the outer environment before this
# function ever runs and would silently clobber the saved value otherwise.
# Returns 1 (without exiting) if the file is missing required/valid fields,
# so the caller can fall through to fresh discovery instead of starting a
# server with a bad or empty transport address.
load_saved_config() {
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    TRANSPORT="${PC1_PHOMEMO_TRANSPORT:-}"

    if [ "$TRANSPORT" = "bluetooth" ]; then
        BT_ADDRESS="${PC1_PHOMEMO_BT_ADDRESS:-}"
        if ! [[ "$BT_ADDRESS" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]]; then
            log "Saved config invalid — rerunning discovery"
            return 1
        fi
    elif [ "$TRANSPORT" = "usb" ]; then
        :
    else
        log "Saved config invalid — rerunning discovery"
        return 1
    fi

    log "Reusing saved config from $ENV_FILE (use --rediscover to force a fresh scan)."
    return 0
}

install_daemon() {
    if ! command -v rsync >/dev/null 2>&1; then
        echo "Error: --install-daemon requires rsync." >&2
        exit 1
    fi
    if ! command -v systemctl >/dev/null 2>&1; then
        echo "Error: --install-daemon requires systemd (systemctl not found)." >&2
        exit 1
    fi

    if [ "$REPO_DIR" = "$INSTALL_DIR" ]; then
        log "Running from the install dir; skipping file copy."
    else
        log "Installing to $INSTALL_DIR..."
        mkdir -p "$INSTALL_DIR/web"
        local item
        for item in app icons requirements.txt faxomemo; do
            rsync -a --delete "$REPO_DIR/$item" "$INSTALL_DIR/"
        done
        for item in web/dist web/public; do
            if [ -d "$REPO_DIR/$item" ]; then
                rsync -a --delete "$REPO_DIR/$item" "$INSTALL_DIR/web/"
            else
                log "Warning: $item not found; the web UI needs 'npm run build' in web/ first."
            fi
        done
        # The label designer is optional; scripts/fetch_label_designer.sh installs it.
        if [ -d "$REPO_DIR/vendor" ]; then
            rsync -a --delete "$REPO_DIR/vendor" "$INSTALL_DIR/"
        fi
        if [ ! -f "$INSTALL_DIR/config.json" ] && [ -f "$REPO_DIR/config.json" ]; then
            cp "$REPO_DIR/config.json" "$INSTALL_DIR/"
        fi
    fi

    ( cd "$INSTALL_DIR" && VENV_DIR="$INSTALL_DIR/.venv" setup_venv )

    local unit_file="$UNIT_DIR/faxomemo.service"
    local already_installed=0
    if [ -f "$unit_file" ]; then
        already_installed=1
    fi
    log "Writing $unit_file..."
    mkdir -p "$UNIT_DIR"
    cat > "$unit_file" <<EOF
[Unit]
Description=faxomemo printer server
After=network-online.target bluetooth.target

[Service]
Type=simple
WorkingDirectory=$INSTALL_DIR
ExecStart=/bin/bash $INSTALL_DIR/faxomemo --daemon --skip-ready
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
EOF

    if ! loginctl enable-linger "$USER" 2>/dev/null; then
        log "Warning: could not enable lingering; the daemon will only run while you are logged in."
    fi
    systemctl --user daemon-reload
    if [ "$already_installed" -eq 1 ]; then
        systemctl --user restart faxomemo
        log "Updated install and restarted the service."
    else
        systemctl --user enable --now faxomemo
        log "Installed and started the service."
    fi
    log "Follow it with: journalctl --user -u faxomemo -f"
}

server_is_up() {
    (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null
}

wait_for_server() {
    local deadline=$((SECONDS + ${1:-30}))
    while [ "$SECONDS" -lt "$deadline" ]; do
        server_is_up && return 0
        sleep 0.5
    done
    return 1
}

# Read the Device Password the settings UI asks for. Prefer the installed copy,
# so the value matches the one the running daemon checks against.
show_device_password() {
    local dir="$REPO_DIR"
    if [ -d "$INSTALL_DIR/app" ]; then
        dir="$INSTALL_DIR"
    fi

    local python_bin="python3"
    if [ -x "$dir/.venv/bin/python" ]; then
        python_bin="$dir/.venv/bin/python"
    fi

    local password
    password="$(cd "$dir" && "$python_bin" -c 'from app import device_password; print(device_password.get_device_password())' 2>/dev/null)"

    if [ -n "$password" ]; then
        log "Device Password: $password"
    else
        log "Warning: could not read the Device Password."
    fi
}

open_web_ui() {
    local url="http://127.0.0.1:$PORT/"

    if ! server_is_up; then
        if [ -f "$UNIT_DIR/faxomemo.service" ] && command -v systemctl >/dev/null 2>&1; then
            log "Nothing on port $PORT yet. Starting the faxomemo service..."
            systemctl --user start faxomemo || true
            if ! wait_for_server 30; then
                echo "Error: faxomemo did not start listening on port $PORT." >&2
                echo "Check it with: journalctl --user -u faxomemo -n 50" >&2
                exit 1
            fi
        else
            echo "Error: nothing is listening on port $PORT." >&2
            echo "Start faxomemo with './faxomemo', or install it as a service" >&2
            echo "with './faxomemo --install-daemon' and try again." >&2
            exit 1
        fi
    fi

    show_device_password
    log "Opening $url"
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1 &
    elif command -v open >/dev/null 2>&1; then
        open "$url"
    else
        echo "$url"
    fi
}

uninstall_daemon() {
    systemctl --user disable --now faxomemo 2>/dev/null || true
    rm -f "$UNIT_DIR/faxomemo.service"
    systemctl --user daemon-reload 2>/dev/null || true
    # Sanity-check before rm -rf: only remove a dir that contains our launcher.
    if [ -f "$INSTALL_DIR/faxomemo" ]; then
        rm -rf "$INSTALL_DIR"
        log "Removed $INSTALL_DIR."
    elif [ -e "$INSTALL_DIR" ]; then
        log "Warning: $INSTALL_DIR does not look like a faxomemo install; not removing it."
    fi
    log "Service uninstalled."
}

main() {
    setup_venv

    if [ "$REDISCOVER" -eq 0 ] && [ -z "$TRANSPORT_OVERRIDE" ] && [ "$DRY_RUN" -eq 0 ] && [ -f "$ENV_FILE" ] && load_saved_config; then
        :
    else
        if [ -n "$TRANSPORT_OVERRIDE" ]; then
            TRANSPORT="$TRANSPORT_OVERRIDE"
            log "Transport overridden to: $TRANSPORT"
            if [ "$TRANSPORT" = "usb" ]; then
                detect_usb || log "Proceeding with USB despite no device detected (overridden)."
            else
                detect_bluetooth || {
                    if [ "$DRY_RUN" -eq 0 ]; then
                        exit 1
                    fi
                }
            fi
        else
            while true; do
                if detect_usb; then
                    TRANSPORT="usb"
                    break
                elif detect_bluetooth; then
                    TRANSPORT="bluetooth"
                    break
                elif [ "$DAEMON" -eq 1 ]; then
                    log "No printer found; retrying in ${POLL_INTERVAL}s."
                    sleep "$POLL_INTERVAL"
                else
                    log "Could not detect a printer over USB or Bluetooth."
                    exit 1
                fi
            done
        fi

        if [ "$DRY_RUN" -eq 0 ]; then
            write_env_file
        fi
    fi

    export PC1_PRINTER_DRIVER=phomemo
    export PC1_PHOMEMO_TRANSPORT="$TRANSPORT"
    if [ "$SKIP_READY" -eq 1 ]; then
        export PC1_SKIP_READY_PRINT=1
    fi
    if [ "$TRANSPORT" = "usb" ]; then
        export PC1_PHOMEMO_USB_DEVICE="$(usb_device_path)"
    else
        export PC1_PHOMEMO_BT_ADDRESS="$BT_ADDRESS"
    fi

    local python_bin="python3"
    if [ -x "$VENV_DIR/bin/python" ]; then
        python_bin="$VENV_DIR/bin/python"
    fi

    log "Final environment:"
    log "  PC1_PRINTER_DRIVER=$PC1_PRINTER_DRIVER"
    log "  PC1_PHOMEMO_TRANSPORT=$PC1_PHOMEMO_TRANSPORT"
    if [ "$TRANSPORT" = "usb" ]; then
        log "  PC1_PHOMEMO_USB_DEVICE=${PC1_PHOMEMO_USB_DEVICE:-}"
    else
        log "  PC1_PHOMEMO_BT_ADDRESS=${PC1_PHOMEMO_BT_ADDRESS:-}"
    fi
    log "Command: $python_bin -m uvicorn app.main:app --host 0.0.0.0 --port $PORT"

    if [ "$DRY_RUN" -eq 1 ]; then
        log "(dry-run) not starting the server."
        exit 0
    fi

    exec "$python_bin" -m uvicorn app.main:app --host 0.0.0.0 --port "$PORT"
}

if [ "$WEB" -eq 1 ]; then
    open_web_ui
    exit 0
fi
if [ "$UNINSTALL" -eq 1 ]; then
    uninstall_daemon
    exit 0
fi
if [ "$INSTALL" -eq 1 ]; then
    install_daemon
    exit 0
fi
main
